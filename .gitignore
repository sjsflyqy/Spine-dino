# -----------------------------------------------------------------------------
# Spine-DINO: local datasets, model artifacts, and experiment outputs
# -----------------------------------------------------------------------------

# Generated portable datasets. These contain medical images and are transferred
# to training machines separately; never commit them to the source repository.
/SpinePretrain-v1/
/Downstream/data/

# Common medical/data artifacts and dataset archives. Keep reusable metadata
# (for example YAML, JSON, and CSV reports) tracked unless it is under data/.
*.dcm
*.dicom
*.nii
*.nii.gz
*.h5
*.hdf5
*.npy
*.npz
*.pkl
*.pickle
*.mat
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar

# Downloaded, converted, and trained model weights.
/weights/
*.pt
*.pth
*.ckpt
*.distcp
*.safetensors
*.onnx
*.tflite
*.pb
*.rank_[0-9]*
last_checkpoint*

# Training, evaluation, and application runtime outputs.
/outputs/
checkpoints/
logs/
results/
uploads/
predictions/
wandb/
mlruns/
lightning_logs/
.hydra/
events.out.tfevents.*
slurm-*.out

